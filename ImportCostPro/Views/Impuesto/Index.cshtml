@model ImportCostPro.Models.ImpuestoViewModel

@{
    ViewData["Title"] = "Configuración de Impuestos";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Configuración de Impuestos</h1>
            <p class="text-muted small mb-0">Gestión de tasas impositivas aplicables a la importación.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm bg-white" style="max-width: 600px;">
        <div class="card-body p-4">
            <form asp-controller="Impuesto" asp-action="Guardar" method="post">
                
                <div class="mb-3">
                    <label asp-for="PorcentajeITBIS" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeITBIS" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeITBIS" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="PorcentajeTasaServicioAduanal" class="form-label fw-bold"></label>
                    <div class="input-group">
                        <input asp-for="PorcentajeTasaServicioAduanal" class="form-control" type="number" step="0.01" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="PorcentajeTasaServicioAduanal" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary shadow-sm px-4">
                    <i class="bi bi-save me-2"></i>Guardar Configuración
                </button>
            </form>
        </div>
    </div>
</div>