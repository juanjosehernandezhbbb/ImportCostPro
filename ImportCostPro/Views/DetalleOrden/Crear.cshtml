@model ImportCostPro.Application.DTOs.DetallesOrden.AgregarProductoOrdenDto

@{
    // Si tenemos un ID, estamos editando; si no, estamos creando.
    ViewData["Title"] = Model.Id == 0 ? "Agregar Producto" : "Editar Producto";
    // Usamos el ID de la orden del modelo, si es 0, usamos el ViewBag.OrdenId
    var ordenId = Model.OrdenImportacionId != 0 ? Model.OrdenImportacionId : (int)ViewBag.OrdenId;
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0">@(Model.Id == 0 ? "Agregar Producto a la Orden" : "Editar Producto en la Orden")</h4>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action='@(Model.Id == 0 ? "Crear" : "Editar")' method="post">
                
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="OrdenImportacionId" value="@ordenId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">Producto</label>
                    <select asp-for="ProductoId" asp-items="ViewBag.Productos" class="form-select" required>
                        <option value="" disabled selected>-- Seleccione un producto --</option>
                    </select>
                    <span asp-validation-for="ProductoId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Descripción</label>
                    <input asp-for="Descripcion" class="form-control" placeholder="Detalles adicionales..." />
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Cantidad</label>
                        <input asp-for="Cantidad" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Cantidad" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Precio FOB</label>
                        <input asp-for="PrecioUnitarioFOB" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="PrecioUnitarioFOB" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Margen Deseado (%)</label>
                        <input asp-for="MargenDeseado" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="MargenDeseado" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary px-4">Guardar Producto</button>
                    <a asp-controller="OrdenImportacion" asp-action="Editar" asp-route-id="@ordenId" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}