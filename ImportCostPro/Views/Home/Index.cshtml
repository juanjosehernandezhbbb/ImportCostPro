
@{
    ViewData["Title"] = "Inicio";
}


<div class="container-fluid px-4 py-5">
    <div class="row align-items-center g-5 py-5 mb-5 bg-white rounded-3 shadow-sm border">
        <div class="col-10 col-sm-8 col-lg-6">
            <h1 class="display-5 fw-bold text-dark lh-1 mb-3">Sistema de Gestión de Importaciones</h1>
            <p class="lead text-muted">
                Bienvenido a <strong>ImportCost Pro</strong>, la plataforma centralizada para el cálculo preciso de costos desembarcados, control de aranceles, gestión de tasas de cambio y seguimiento de órdenes de compra internacionales.
            </p>
            <div class="d-grid gap-2 d-md-flex justify-content-md-start mt-4">
                <a href="#modulos" class="btn btn-primary btn-lg px-4 me-md-2 shadow-sm">
                    <i class="bi bi-grid-fill me-2"></i>Ver Módulos
                </a>
                <button type="button" class="btn btn-outline-secondary btn-lg px-4" data-bs-toggle="modal" data-bs-target="#equipoModal">
                    <i class="bi bi-people-fill me-2"></i>Ver Equipo
                </button>
            </div>
        </div>
        <div class="col-lg-6 d-flex justify-content-center">
            <i class="bi bi-calculator text-primary-emphasis" style="font-size: 10rem; filter: drop-shadow(3px 5px 2px rgb(0 0 0 / 0.1));"></i>
        </div>
    </div>

    <h2 id="modulos" class="pb-2 border-bottom fw-bold mb-4">Estructura del Sistema</h2>
    
    <div class="row row-cols-1 row-cols-md-3 g-4 mb-5">
        <div class="col">
            <div class="card h-100 border-0 shadow-sm bg-white p-3">
                <div class="card-body">
                    <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-primary bg-gradient fs-2 rounded-3 px-3 py-2 mb-3">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                    <h4 class="card-title fw-bold text-dark">Tablas de Soporte</h4>
                    <p class="card-text text-muted">Administración de catálogos base requeridos para la operación: Países, Monedas, Importadores, Proveedores y Productos.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm bg-white p-3">
                <div class="card-body">
                    <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-success bg-gradient fs-2 rounded-3 px-3 py-2 mb-3">
                        <i class="bi bi-percent"></i>
                    </div>
                    <h4 class="card-title fw-bold text-dark">Configuraciones</h4>
                    <p class="card-text text-muted">Control de tasas de cambio dinámicas por monedas e impuestos aduanales (aranceles específicos e ITBIS) basados en la categoría arancelaria.</p>
                </div>
            </div>
        </div>

        <div class="col">
            <div class="card h-100 border-0 shadow-sm bg-white p-3">
                <div class="card-body">
                    <div class="feature-icon d-inline-flex align-items-center justify-content-center text-bg-warning bg-gradient fs-2 rounded-3 px-3 py-2 mb-3 text-white">
                        <i class="bi bi-receipt-cutoff"></i>
                    </div>
                    <h4 class="card-title fw-bold text-dark">Cálculos Clave</h4>
                    <p class="card-text text-muted">Registro de Órdenes de Importación y prorrateo automático de gastos (Flete, Seguro, Manejo) para determinar el Landed Cost final.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="equipoModal" tabindex="-1" aria-labelledby="equipoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="equipoModalLabel"><i class="bi bi-code-square me-2"></i>Equipo de Desarrollo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-toggle="modal" data-bs-target="#equipoModal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Desarrollador</th>
                                <th>Rol / Capa</th>
                                <th>Responsabilidad</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Juan Hernandez</strong></td>
                                <td><span class="badge bg-info text-dark">Capa de Datos</span></td>
                                <td class="small text-muted">Base de datos SQL, Tablas, Procedimientos Almacenados y DDL/DML.</td>
                            </tr>
                            <tr>
                                <td><strong>Bryan</strong></td>
                                <td><span class="badge bg-success text-white">Capa de Negocio</span></td>
                                <td class="small text-muted">Lógica matemática de prorrateo, cálculos de impuestos y servicios internos.</td>
                            </tr>
                            <tr>
                                <td><strong>Juan Francisco Jiménez C.</strong></td>
                                <td><span class="badge bg-primary text-white">Capa de Presentación</span></td>
                                <td class="small text-muted">Desarrollo de Vistas Razor, ViewModels, Controladores e Interfaz Web.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>