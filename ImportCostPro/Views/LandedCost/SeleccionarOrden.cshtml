@model IEnumerable<Persistance.Entities.OrdenImportacion>

<div class="container py-4">
    <h3>Seleccionar orden para calcular Landed Cost</h3>
    <hr />
    
    <form asp-controller="LandedCost" asp-action="ProcesarSeleccion" method="post">
        @Html.AntiForgeryToken() 
        
        <div class="form-group mb-3">
            <label>Órdenes disponibles (Abiertas):</label>
            <select name="ordenId" class="form-control" required>
                <option value="">-- Seleccione una orden --</option>
                @foreach (var o in Model)
                {
                    <option value="@o.Id">@o.NumeroOrden - @o.FechaOrden.ToShortDateString()</option>
                }
            </select>
        </div>
        
        <button type="submit" class="btn btn-primary">Calcular Costos</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>