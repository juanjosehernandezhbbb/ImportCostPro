@model IEnumerable<ImportCostPro.Application.DTOs.Calculos.CalculoLandedCostDto>

<div class="container py-4">
    <h3>Histórico de Cálculos</h3>
    <div class="d-flex justify-content-between mb-3">
    <a asp-action="SeleccionarOrden" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Nuevo Cálculo de Orden
    </a>
</div>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>N° Orden</th>
                <th>Fecha Cálculo</th>
                <th>Total Costo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.NumeroOrden</td>
                    <td>@item.FechaCalculo.ToString("dd/MM/yyyy")</td>
                    <td>@item.TotalCosto.ToString("C")</td>
                    <td>
                        <a asp-action="Detalle" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver Detalle</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>