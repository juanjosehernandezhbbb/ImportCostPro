@model IEnumerable<ImportCostPro.Application.DTOs.Gasto.GastoImportacionDto>

@{
    ViewData["Title"] = "Gestión de Gastos";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3>Gestión Global de Gastos</h3>
            <p class="text-muted">Listado consolidado de gastos por orden de importación.</p>
        </div>
        
        <a asp-action="SeleccionarOrden" class="btn btn-success shadow-sm px-4">
            <i class="bi bi-plus-circle"></i> Nuevo Gasto
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4"># Orden</th>
                        <th>Fecha</th>
                        <th>Tipo de Gasto</th>
                        <th>Monto</th>
                        <th>Distribución</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">No hay gastos registrados actualmente.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.NumeroOrden</td>
                                <td>@item.FechaGasto.ToShortDateString()</td>
                                <td>@item.TipoGasto</td>
                                <td>@item.Monto.ToString("N2")</td>
                                <td>@item.MetodoDistribucion</td>
                                <td class="text-end pe-4">
                                    <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                    
                                    <form asp-action="Eliminar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                onclick="return confirm('¿Está seguro de eliminar este gasto?')">
                                            Eliminar
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>