@model ImportCostPro.Application.DTOs.Gasto.AgregarGastoDto

@{
    ViewData["Title"] = "Registrar Gasto";
}

<div class="container py-4">
    <h3>Registrar Nuevo Gasto</h3>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger shadow-sm">
            <strong>Error:</strong> @TempData["Error"]
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="Crear" method="post" class="card p-4 shadow-sm">
        
        <input type="hidden" asp-for="OrdenImportacionId" />

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo de Gasto</label>
                <select asp-for="TipoGasto" asp-items="Html.GetEnumSelectList<Persistance.Enums.TipoGasto>()" class="form-select"></select>
                <span asp-validation-for="TipoGasto" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Monto</label>
                <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Monto" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha de Gasto</label>
                <input asp-for="FechaGasto" class="form-control" type="date" />
                <span asp-validation-for="FechaGasto" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Moneda</label>
                <select asp-for="MonedaID" asp-items="ViewBag.Monedas" class="form-select">
                    <option value="">-- Seleccione una moneda --</option>
                </select>
                <span asp-validation-for="MonedaID" class="text-danger"></span>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Método de Distribución</label>
                <select asp-for="MetodoDistribucion" asp-items="Html.GetEnumSelectList<Persistance.Enums.MetodoDistribucion>()" class="form-select"></select>
                <span asp-validation-for="MetodoDistribucion" class="text-danger"></span>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">Guardar Gasto</button>
            <a asp-action="Index" 
               asp-controller="GastoImportacion" 
               asp-route-ordenId="@Model.OrdenImportacionId" 
               class="btn btn-secondary">Volver al listado</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}