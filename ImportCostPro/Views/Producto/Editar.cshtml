@model ImportCostPro.Application.DTOs.Producto.CrearProductoDto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 fw-bold">Editar Producto</h1>
    <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<form asp-action="Editar" method="post" class="card p-4 shadow-sm border-0">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Codigo" class="form-label"></label>
            <input asp-for="Codigo" class="form-control" />
            <span asp-validation-for="Codigo" class="text-danger small"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">País de Origen</label>
            <select asp-for="PaisOrigenID" class="form-select" asp-items="ViewBag.Paises">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Categoría Arancelaria</label>
            <select asp-for="CategoriaArancelariaID" class="form-select" asp-items="ViewBag.Categorias">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Unidad de Medida</label>
            <select asp-for="UnidadDeMedidaID" class="form-select" asp-items="ViewBag.UnidadesMedida">
                <option value="">-- Seleccione --</option>
            </select>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="PesoUnitario" class="form-label">Peso Unitario (kg)</label>
            <input asp-for="PesoUnitario" class="form-control" type="number" step="0.001" />
            <span asp-validation-for="PesoUnitario" class="text-danger small"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Largo" class="form-label">Largo (cm)</label>
            <input asp-for="Largo" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Ancho" class="form-label">Ancho (cm)</label>
            <input asp-for="Ancho" class="form-control" type="number" step="0.01" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Alto" class="form-label">Alto (cm)</label>
            <input asp-for="Alto" class="form-control" type="number" step="0.01" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy-fill me-1"></i> Guardar Cambios
        </button>
        <a asp-controller="Producto" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
