@model IEnumerable<ImportCostPro.Models.ProductoViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Productos";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Mantenimiento de Productos</h1>
            <p class="text-muted small mb-0">Gestión del catálogo de artículos disponibles para órdenes de compra e importación.</p>
        </div>
        <a asp-controller="Producto" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Agregar Producto
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Código</th>
                            <th>Descripción / Artículo</th>
                            <th>Detalles</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var producto in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@producto.Id</td>
                                    <td><span class="badge bg-secondary font-monospace px-2 py-1">@producto.Codigo</span></td>
                                    <td class="fw-bold text-dark">@producto.Nombre</td>
                                    <td class="text-muted small text-truncate" style="max-width: 300px;">@producto.Descripcion</td>
                                    <td>
                                        @if (producto.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Disponible</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Descontinuado</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Producto" asp-action="Editar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="Producto" asp-action="Eliminar" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam display-4 mb-3 d-block"></i>
                                    No hay registros de productos configurados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>