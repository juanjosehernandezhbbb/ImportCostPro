@model ImportCostPro.Application.DTOs.Producto.CrearProductoDto

@{ ViewData["Title"] = "Nuevo Producto"; }

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h4 fw-bold text-primary"><i class="bi bi-box-seam me-2"></i>Nuevo Producto</h1>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver</a>
    </div>

    <form asp-action="Crear" method="post" class="card p-4 shadow-sm border-0">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Codigo" class="form-label fw-semibold"></label>
                <input asp-for="Codigo" class="form-control" />
                <span asp-validation-for="Codigo" class="text-danger small"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold">País de Origen</label>
                <select asp-for="PaisOrigenID" class="form-select" asp-items="ViewBag.Paises">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold">Categoría Arancelaria</label>
                <select asp-for="CategoriaArancelariaID" class="form-select" asp-items="ViewBag.Categorias">
                    <option value="">-- Seleccione --</option>
                </select>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label fw-semibold">Unidad de Medida</label>
                <select asp-for="UnidadDeMedidaID" class="form-select" asp-items="ViewBag.UnidadesMedida"></select>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="PesoUnitario" class="form-label fw-semibold">Peso (kg)</label>
                <input asp-for="PesoUnitario" class="form-control" type="number" step="0.001" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Largo" class="form-label fw-semibold">Largo (cm)</label>
                <input asp-for="Largo" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Ancho" class="form-label fw-semibold">Ancho (cm)</label>
                <input asp-for="Ancho" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="Alto" class="form-label fw-semibold">Alto (cm)</label>
                <input asp-for="Alto" class="form-control" type="number" step="0.01" />
            </div>
        </div>

        <div class="mb-4">
            <label asp-for="Descripcion" class="form-label fw-semibold"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="2"></textarea>
        </div>

        <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i>Guardar Producto</button>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}