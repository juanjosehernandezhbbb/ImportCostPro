@model IEnumerable<ImportCostPro.Models.TasaCambioViewModel>

@{
    ViewData["Title"] = "Tasas de Cambio";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Historial de Tasas de Cambio</h1>
            <p class="text-muted small mb-0">Gestión diario o histórico de las equivalencias de conversión de divisas.</p>
        </div>
        <a asp-controller="TasaCambio" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Tasa
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Fecha</th>
                            <th>Conversión</th>
                            <th>Factor de Cambio</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var tasa in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@tasa.Id</td>
                                    <td>@tasa.Fecha.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-primary px-2 py-1 font-monospace">@tasa.CodigoMonedaOrigen</span>
                                        <i class="bi bi-arrow-right mx-2 text-muted"></i>
                                        <span class="badge bg-secondary px-2 py-1 font-monospace">@tasa.CodigoMonedaDestino</span>
                                    </td>
                                    <td class="fw-bold text-success">
                                        1 @tasa.CodigoMonedaOrigen = @tasa.ValorTasa.ToString("N2") @tasa.CodigoMonedaDestino
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="TasaCambio" asp-action="Editar" asp-route-id="@tasa.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="TasaCambio" asp-action="Eliminar" asp-route-id="@tasa.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-currency-exchange display-4 mb-3 d-block"></i>
                                    No hay registros de tasas de cambio cargados para el día de hoy.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>