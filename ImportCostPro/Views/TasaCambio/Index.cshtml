@model IEnumerable<ImportCostPro.Application.DTOs.TasasCambio.TasaCambioDto>

@{
    ViewData["Title"] = "Tasas de Cambio";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Historial de Tasas de Cambio</h1>
        </div>
        <a asp-controller="TasaCambio" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Registrar Tasa
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Fecha</th>
                        <th>Conversión</th>
                        <th>Factor de Cambio</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tasa in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">@tasa.Id</td>
                            <td>@tasa.FechaVigencia.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-primary px-2 py-1">@tasa.NombreMonedaOrigen</span>
                                <i class="bi bi-arrow-right mx-2"></i>
                                <span class="badge bg-secondary px-2 py-1">@tasa.NombreMonedaDestino</span>
                            </td>
                            <td class="fw-bold text-success">@tasa.ValorTasa.ToString("N4")</td>
                            <td class="text-end pe-4">
                                <a asp-action="Editar" asp-route-id="@tasa.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil-square"></i></a>
                                
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@tasa.Id">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </td>
                        </tr>

                        <div class="modal fade" id="deleteModal-@tasa.Id" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Confirmar Eliminación</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        ¿Está seguro de que desea eliminar la tasa de <strong>@tasa.NombreMonedaOrigen</strong> a <strong>@tasa.NombreMonedaDestino</strong>? Esta acción no se puede deshacer.
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <form asp-action="EliminarConfirmado" asp-route-id="@tasa.Id" method="post">
                                            <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>