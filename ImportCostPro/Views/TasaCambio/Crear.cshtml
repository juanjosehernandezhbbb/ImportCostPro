@model ImportCostPro.Application.DTOs.TasasCambio.CrearTasaCambioDto

@{
    ViewData["Title"] = "Registrar Tasa";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0">Registrar Nueva Tasa de Cambio</h4>
        </div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Moneda Origen</label>
                    <select asp-for="MonedaOrigenID" asp-items="ViewBag.Monedas" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Moneda Destino</label>
                    <select asp-for="MonedaDestinoID" asp-items="ViewBag.Monedas" class="form-select"></select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Valor de la Tasa</label>
                    <input asp-for="ValorTasa" type="number" step="0.0001" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Fecha de Vigencia</label>
                    <input asp-for="FechaVigencia" type="date" class="form-control" />
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Guardar Registro</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>