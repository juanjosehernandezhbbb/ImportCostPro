@model IEnumerable<ImportCostPro.Application.DTOs.Proveedores.ProveedorDto>

@{
    ViewData["Title"] = "Mantenimiento de Proveedores";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Mantenimiento de Proveedores</h1>
            <p class="text-muted small mb-0">Gestión de proveedores internacionales de mercancías.</p>
        </div>
        <a asp-controller="Proveedor" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Agregar Proveedor
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nombre / Razón Social</th>
                            <th>País (ID)</th>
                            <th>Correo Electrónico</th>
                            <th>Teléfono</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var proveedor in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@proveedor.Id</td>
                                    <td>@proveedor.Nombre</td>
                                    <td>@proveedor.PaisOrigenID</td>
                                    <td>@proveedor.Correo</td>
                                    <td>@proveedor.Telefono</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Proveedor" asp-action="Editar" asp-route-id="@proveedor.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@proveedor.Id">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <div class="modal fade" id="deleteModal-@proveedor.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirmar eliminación</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                ¿Estás seguro de eliminar a <strong>@proveedor.Nombre</strong>? Esta acción no se puede deshacer.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-controller="Proveedor" asp-action="EliminarConfirmado" asp-route-id="@proveedor.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-truck display-4 mb-3 d-block"></i>
                                    No hay registros de proveedores configurados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>