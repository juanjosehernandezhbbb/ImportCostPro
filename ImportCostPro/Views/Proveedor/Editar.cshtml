@model ImportCostPro.Application.DTOs.Proveedores.CrearProveedorDto

@{ 
    ViewData["Title"] = "Editar Proveedor"; 
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Editar Proveedor</h2>
    
    <form asp-action="Editar" asp-route-id="@Model.Id" method="post" class="card p-4 shadow-sm border-0">
        @* Este campo oculto asegura que el ID viaje correctamente al controlador *@
        <input type="hidden" asp-for="Id" />
        
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">País de Origen</label>
                <select asp-for="PaisOrigenID" class="form-select" asp-items="ViewBag.Paises">
                    <option value="">-- Seleccione un país --</option>
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Moneda Principal</label>
                <select asp-for="MonedaPrincipalID" class="form-select" asp-items="ViewBag.Monedas">
                    <option value="">-- Seleccione una moneda --</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Correo" class="form-label"></label>
                <input asp-for="Correo" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Telefono" class="form-label"></label>
                <input asp-for="Telefono" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Direccion" class="form-label"></label>
            <textarea asp-for="Direccion" class="form-control" rows="3"></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-success">Guardar Cambios</button>
        </div>
    </form>
</div>