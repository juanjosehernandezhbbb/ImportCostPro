<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ImportCost Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body {
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            overflow: hidden !important;
            background-color: #f8f9fa;
        }

        .app-container {
            display: flex !important;
            height: 100vh !important;
            width: 100vw !important;
            overflow: hidden !important;
        }

        .sidebar-menu {
            width: 280px !important;
            min-width: 280px !important;
            max-width: 280px !important;
            background-color: #212529 !important;
            color: #fff !important;
            display: flex !important;
            flex-direction: column !important;
            height: 100% !important;
            z-index: 100;
        }

        .menu-lista-scroll {
            flex: 1 1 auto !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            list-style: none !important;
        }

        .menu-lista-scroll .link-item {
            color: #adb5bd !important;
            padding: 0.8rem 1rem !important;
            display: flex !important;
            align-items: center !important;
            gap: 10px !important;
            width: 100% !important;
            text-decoration: none !important;
        }

        .menu-lista-scroll .link-item:hover {
            color: #fff !important;
            background-color: #343a40 !important;
            border-left: 4px solid #0d6efd !important;
        }

        .menu-lista-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .menu-lista-scroll::-webkit-scrollbar-thumb {
            background: #495057;
            border-radius: 4px;
        }

        .page-content {
            flex-grow: 1 !important;
            height: 100vh !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            padding: 2rem !important;
            box-sizing: border-box !important;
            scroll-behavior: smooth !important;
        }
    </style>
</head>
<body>

    <div class="app-container">
        <div class="sidebar-menu p-3">
            <a href="/" class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none gap-2">
                <i class="bi bi-box-seam-fill text-primary fs-4"></i>
                <span class="fs-4 fw-bold">ImportCost Pro</span>
            </a>
            <hr>
            
            <ul class="menu-lista-scroll">
                <li>
                    <a asp-controller="Home" asp-action="Index" class="link-item">
                        <i class="bi bi-house-door"></i> Home
                    </a>
                </li>
                
                <li class="text-muted small fw-bold text-uppercase px-3 mt-3 mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Mantenimientos</li>
                <li><a asp-controller="Pais" asp-action="Index" class="link-item"><i class="bi bi-globe"></i> Países</a></li>
                <li><a asp-controller="Moneda" asp-action="Index" class="link-item"><i class="bi bi-cash-coin"></i> Monedas</a></li>
                <li><a asp-controller="Importador" asp-action="Index" class="link-item"><i class="bi bi-building"></i> Importadores</a></li>
                <li><a asp-controller="Proveedor" asp-action="Index" class="link-item"><i class="bi bi-truck"></i> Proveedores</a></li>
                <li><a asp-controller="Producto" asp-action="Index" class="link-item"><i class="bi bi-box-seam"></i> Productos</a></li>
                <li><a asp-controller="CategoriaArancelaria" asp-action="Index" class="link-item"><i class="bi bi-file-earmark-ruled"></i> Cat. Arancelarias</a></li>
                <li><a asp-controller="TasaCambio" asp-action="Index" class="link-item"><i class="bi bi-graph-up-arrow"></i> Tasas de Cambio</a></li>
                <li><a asp-controller="Impuesto" asp-action="Index" class="link-item"><i class="bi bi-percent"></i> Config. Impuestos</a></li>

                <li class="text-muted small fw-bold text-uppercase px-3 mt-3 mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Operaciones Core</li>
                <li><a asp-controller="OrdenImportacion" asp-action="Index" class="link-item"><i class="bi bi-file-earmark-text"></i> Órdenes</a></li>
                <li><a asp-controller="GastoImportacion" asp-action="Index" class="link-item"><i class="bi bi-receipt"></i> Gastos</a></li>
                <li><a asp-controller="LandedCost" asp-action="Index" class="link-item"><i class="bi bi-calculator-fill text-warning"></i> Cálculo Landed</a></li>
            </ul>
            <hr>
            
            <div class="small text-muted px-2">
                <i class="bi bi-person-badge"></i> Dev: <strong>Juan Jimenez</strong><br />
                <span class="text-uppercase font-monospace" style="font-size: 0.75rem;">ID: 2025-1030</span>
            </div>
        </div>

        <div class="page-content">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>