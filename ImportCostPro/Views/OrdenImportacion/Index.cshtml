@model IEnumerable<ImportCostPro.Application.DTOs.Ordenes.OrdenImportacionDto>

@{
    ViewData["Title"] = "Gestión de Órdenes";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Órdenes de Importación</h1>
            <p class="text-muted small">Gestión y seguimiento de órdenes de compra internacionales.</p>
        </div>
        <a asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Nueva Orden
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="table-responsive">
            <div class="mb-4">
    <div class="btn-group" role="group">
        <a asp-action="Index" asp-route-filtroEstado="Activas" 
           class="btn @(ViewBag.FiltroActual == "Activas" ? "btn-primary" : "btn-outline-primary")">
           <i class="bi bi-play-circle me-1"></i> Órdenes Activas
        </a>
        <a asp-action="Index" asp-route-filtroEstado="Historico" 
           class="btn @(ViewBag.FiltroActual == "Historico" ? "btn-primary" : "btn-outline-primary")">
           <i class="bi bi-clock-history me-1"></i> Histórico (Calculadas/Cerradas)
        </a>
    </div>
</div>
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">N° Orden</th>
                        <th>Fecha</th>
                        <th>Importador</th>
                        <th>Proveedor</th>
                        <th>Estado</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var orden in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@orden.NumeroOrden</td>
                                <td>@orden.FechaOrden.ToString("dd/MM/yyyy")</td>
                                <td>@orden.NombreImportador</td>
                                <td>@orden.NombreProveedor</td>
                                <td>
                                    <span class="badge @(orden.Estado == Persistance.Enums.EstadoOrden.Abierta ? "bg-success" : "bg-warning")">
                                        @orden.Estado
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group">
                                        <a asp-action="Editar" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-secondary" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        @if (orden.Estado == Persistance.Enums.EstadoOrden.Abierta)
                                        {
                                            <a asp-action="Previsualizar" asp-controller="LandedCost" asp-route-ordenId="@orden.Id" class="btn btn-sm btn-outline-primary" title="Calcular Landed Cost">
                                                <i class="bi bi-calculator"></i> Calcular
                                            </a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="Orden no editable">
                                                <i class="bi bi-lock"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No hay órdenes registradas.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>