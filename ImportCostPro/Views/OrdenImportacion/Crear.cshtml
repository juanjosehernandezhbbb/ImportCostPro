@model ImportCostPro.Application.DTOs.Ordenes.CrearOrdenDto

@{
    ViewData["Title"] = "Nueva Orden";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h4 class="mb-0">Registrar Nueva Orden</h4>
        </div>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <form asp-action="Crear" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Número de Orden</label>
                        <input asp-for="NumeroOrden" class="form-control" placeholder="Ej: ORD-2026-001" />
                        <span asp-validation-for="NumeroOrden" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Fecha de Orden</label>
                        <input asp-for="FechaOrden" type="date" class="form-control" />
                        <span asp-validation-for="FechaOrden" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">País de Origen</label>
                        <select asp-for="PaisOrigenID" asp-items="ViewBag.Paises" class="form-select">
                            <option value="" disabled selected>-- Seleccione País --</option>
                        </select>
                        <span asp-validation-for="PaisOrigenID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Moneda</label>
                        <select asp-for="MonedaID" asp-items="ViewBag.Monedas" class="form-select">
                            <option value="" disabled selected>-- Seleccione Moneda --</option>
                        </select>
                        <span asp-validation-for="MonedaID" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Importador</label>
                        <select asp-for="ImportadorID" asp-items="ViewBag.Importadores" class="form-select">
                            <option value="" disabled selected>-- Seleccione Importador --</option>
                        </select>
                        <span asp-validation-for="ImportadorID" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Proveedor</label>
                        <select asp-for="ProveedorID" asp-items="ViewBag.Proveedores" class="form-select">
                            <option value="" disabled selected>-- Seleccione Proveedor --</option>
                        </select>
                        <span asp-validation-for="ProveedorID" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Modalidad Transporte</label>
                    <select asp-for="ModalidadTransporte" asp-items="ViewBag.Modalidades" class="form-select">
                        <option value="" disabled selected>-- Seleccione Modalidad --</option>
                    </select>
                    <span asp-validation-for="ModalidadTransporte" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary px-4">Guardar Orden</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}