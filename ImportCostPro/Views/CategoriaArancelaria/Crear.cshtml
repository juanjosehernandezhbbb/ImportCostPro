@model ImportCostPro.Application.DTOs.CategoriasArancelarias.CategoriaArancelariaCreateDto

@{ ViewData["Title"] = "Nueva Categoría"; }

<div class="container mt-4">
    <h2 class="fw-bold mb-4">Nueva Categoría Arancelaria</h2>
    
    <form asp-action="Crear" method="post" class="card p-4 shadow-sm border-0">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Codigo" class="form-label">Código</label>
                <input asp-for="Codigo" class="form-control" />
            </div>
            <div class="col-md-8 mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" />
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <label asp-for="PorcentajeArancel" class="form-label">% Arancel</label>
                <input asp-for="PorcentajeArancel" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-8 d-flex align-items-center gap-4 pt-4">
                <div class="form-check form-switch">
                    <input asp-for="AplicaITBIS" class="form-check-input" type="checkbox" />
                    <label class="form-check-label">Aplica ITBIS</label>
                </div>
                <div class="form-check form-switch">
                    <input asp-for="Activo" class="form-check-input" type="checkbox" checked />
                    <label class="form-check-label">Activo</label>
                </div>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-4">
                <div class="form-check form-switch">
                    <input asp-for="AplicaImpuestoSelectivo" class="form-check-input" type="checkbox" id="checkSelectivo" onchange="toggleSelectivo(this)" />
                    <label class="form-check-label">Impuesto Selectivo</label>
                </div>
            </div>
            <div class="col-md-4" id="divSelectivo" style="display:none;">
                <label asp-for="PorcentajeImpuestoSelectivo" class="form-label">% Selectivo</label>
                <input asp-for="PorcentajeImpuestoSelectivo" class="form-control" type="number" step="0.01" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function toggleSelectivo(cb) {
            document.getElementById('divSelectivo').style.display = cb.checked ? 'block' : 'none';
        }
    </script>
}