@model ImportCostPro.Application.DTOs.CategoriasArancelarias.CategoriaArancelariaCreateDto

@{
    ViewData["Title"] = "Editar Categoría Arancelaria";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 fw-bold">Editar Categoría Arancelaria</h1>
    <a asp-controller="CategoriaArancelaria" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver
    </a>
</div>

<form asp-action="Editar" method="post" class="card p-4 shadow-sm border-0">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Codigo" class="form-label">Código Arancelario</label>
            <input asp-for="Codigo" class="form-control" />
            <span asp-validation-for="Codigo" class="text-danger small"></span>
        </div>
        <div class="col-md-8 mb-3">
            <label asp-for="Nombre" class="form-label">Nombre</label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="PorcentajeArancel" class="form-label">% Arancel</label>
            <div class="input-group">
                <input asp-for="PorcentajeArancel" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span class="input-group-text">%</span>
            </div>
            <span asp-validation-for="PorcentajeArancel" class="text-danger small"></span>
        </div>
        <div class="col-md-4 mb-3 d-flex align-items-center gap-3 pt-4">
            <div class="form-check form-switch">
                <input asp-for="AplicaITBIS" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="AplicaITBIS" class="form-check-label">Aplica ITBIS</label>
            </div>
            <div class="form-check form-switch">
                <input asp-for="Activo" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="Activo" class="form-check-label">Activo</label>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="form-check form-switch mb-2">
                <input asp-for="AplicaImpuestoSelectivo" class="form-check-input" type="checkbox" role="switch"
                       id="checkSelectivo" onchange="toggleSelectivo(this)" />
                <label asp-for="AplicaImpuestoSelectivo" class="form-check-label">Aplica Imp. Selectivo</label>
            </div>
        </div>
        <div class="col-md-4 mb-3" id="divSelectivo" style="display:@(Model?.AplicaImpuestoSelectivo == true ? "block" : "none")">
            <label asp-for="PorcentajeImpuestoSelectivo" class="form-label">% Imp. Selectivo</label>
            <div class="input-group">
                <input asp-for="PorcentajeImpuestoSelectivo" class="form-control" type="number" step="0.01" min="0" max="100" />
                <span class="input-group-text">%</span>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-floppy-fill me-1"></i> Guardar Cambios
        </button>
        <a asp-controller="CategoriaArancelaria" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function toggleSelectivo(cb) {
            document.getElementById('divSelectivo').style.display = cb.checked ? 'block' : 'none';
        }
    </script>
}
