@model IEnumerable<ImportCostPro.Application.DTOs.CategoriasArancelarias.CategoriaArancelariaDto>

@{
    ViewData["Title"] = "Categorías Arancelarias";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Categorías Arancelarias</h1>
            <p class="text-muted small mb-0">Gestión de categorías y porcentajes de arancel.</p>
        </div>
        <a asp-controller="CategoriaArancelaria" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Nueva Categoría
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th class="text-center">% Arancel</th>
                            <th class="text-center">Aplica ITBIS</th>
                            <th class="text-center">Imp. Selectivo</th>
                            <th class="text-center">% Selectivo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var c in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@c.Id</td>
                                    <td><code>@c.Codigo</code></td>
                                    <td>@c.Nombre</td>
                                    <td class="text-center">@c.PorcentajeArancel.ToString("0.##")%</td>
                                    <td class="text-center">
                                        @if (c.AplicaITBIS)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill text-secondary"></i>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (c.AplicaImpuestoSelectivo)
                                        {
                                            <i class="bi bi-check-circle-fill text-success"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-x-circle-fill text-secondary"></i>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @(c.AplicaImpuestoSelectivo ? $"{c.PorcentajeImpuestoSelectivo.ToString("0.##")}%" : "—")
                                    </td>
                                    <td class="text-center">
                                        @if (c.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="CategoriaArancelaria" asp-action="Editar" asp-route-id="@c.Id"
                                               class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger"
                                                    data-bs-toggle="modal" data-bs-target="#deleteModal-@c.Id">
                                                <i class="bi bi-trash3-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>

                                <div class="modal fade" id="deleteModal-@c.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title">Confirmar eliminación</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body">
                                                ¿Estás seguro de eliminar la categoría <strong>@c.Nombre</strong> (@c.Codigo)?
                                                Esta acción no se puede deshacer.
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                                <form asp-controller="CategoriaArancelaria" asp-action="EliminarConfirmado"
                                                      asp-route-id="@c.Id" method="post" style="display:inline;">
                                                    <button type="submit" class="btn btn-danger">Eliminar</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="bi bi-tags display-4 mb-3 d-block"></i>
                                    No hay categorías arancelarias registradas.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
