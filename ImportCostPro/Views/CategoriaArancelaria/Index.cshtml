@model IEnumerable<ImportCostPro.Models.CategoriaArancelariaViewModel>

@{
    ViewData["Title"] = "Categorías Arancelarias";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Categorías Arancelarias</h1>
            <p class="text-muted small mb-0">Configuración de partidas arancelarias y sus porcentajes de gravamen asignados.</p>
        </div>
        <a asp-controller="CategoriaArancelaria" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Agregar Categoría
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Código / Partida</th>
                            <th>Nombre de la Categoría</th>
                            <th>Arancel (Gravamen)</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var categoria in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@categoria.Id</td>
                                    <td><span class="badge bg-dark font-monospace px-2 py-1">@categoria.Codigo</span></td>
                                    <td>@categoria.Nombre</td>
                                    <td class="fw-bold text-primary">@categoria.PorcentajeArancel.ToString("N2")%</td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="CategoriaArancelaria" asp-action="Editar" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="CategoriaArancelaria" asp-action="Eliminar" asp-route-id="@categoria.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-percent display-4 mb-3 d-block"></i>
                                    No hay registros arancelarios configurados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>