@model IEnumerable<ImportCostPro.Models.MonedaViewModel>

@{
    ViewData["Title"] = "Mantenimiento de Monedas";
}

<div class="container-fluid px-2">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800 fw-bold">Mantenimiento de Monedas</h1>
            <p class="text-muted small mb-0">Configuración de divisas para transacciones internacionales y locales.</p>
        </div>
        <a asp-controller="Moneda" asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle-fill me-2"></i>Agregar Moneda
        </a>
    </div>

    <div class="card border-0 shadow-sm bg-white">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Nombre de la Moneda</th>
                            <th>Código (USD, DOP, etc.)</th>
                            <th>Símbolo</th>
                            <th>Moneda Base</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var moneda in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@moneda.Id</td>
                                    <td>@moneda.Nombre</td>
                                    <td><span class="badge bg-secondary font-monospace px-2 py-1">@moneda.CodigoISO</span></td>
                                    <td class="fw-bold">@moneda.Simbolo</td>
                                    <td>
                                       <td>
                                            @if (moneda.EsMonedaLocal) 
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Sí (Local)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2 py-1">No (Extranjera)</span>
                                            }
                                        </td>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group" role="group">
                                            <a asp-controller="Moneda" asp-action="Editar" asp-route-id="@moneda.Id" class="btn btn-sm btn-outline-secondary">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="Moneda" asp-action="Eliminar" asp-route-id="@moneda.Id" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-cash-stack display-4 mb-3 d-block"></i>
                                    No hay registros de monedas configurados en el sistema.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>