@model ImportCostPro.Models.MonedaViewModel

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3"><h4 class="mb-0">Registrar Moneda</h4></div>
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CodigoISO" class="form-label"></label>
                        <input asp-for="CodigoISO" class="form-control" placeholder="Ej: USD" />
                        <span asp-validation-for="CodigoISO" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Simbolo" class="form-label"></label>
                        <input asp-for="Simbolo" class="form-control" />
                        <span asp-validation-for="Simbolo" class="text-danger"></span>
                    </div>
                </div>
                <div class="mb-3 form-check">
                    <input asp-for="EsMonedaLocal" class="form-check-input" />
                    <label asp-for="EsMonedaLocal" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>